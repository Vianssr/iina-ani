    "只修改外觀／排列，不重設收藏、帳號或下載。預覽、取消及確認保存由既有工作區命令處理；分享包不包含私人資料。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only changes appearance and arrangement, not favorites, accounts, or downloads. Existing workspace commands handle preview, cancel, and save confirmation; shared packages contain no private data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只修改外观和排列，不重置收藏、账号或下载。现有工作区命令负责预览、取消和确认保存；分享包不包含私人数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只修改外觀／排列，不重設收藏、帳號或下載。預覽、取消及確認保存由既有工作區命令處理；分享包不包含私人資料。"
          }
        }
      }
    },
    "只對封面／表情與 metadata 計量；不刪下載或私人資料。0 表示不保留可重建快取。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measures only covers, emoticons, and metadata; downloads and private data are not deleted. Zero retains no rebuildable cache."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只统计封面、表情和元数据；不删除下载或私人数据。0 表示不保留可重建缓存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只對封面／表情與 metadata 計量；不刪下載或私人資料。0 表示不保留可重建快取。"
          }
        }
      }
    },
    "只改外觀；明確選取作者佈局才改排列。取消不保存；預覽不執行業務命令。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only appearance changes unless you explicitly select the author layout. Canceling saves nothing; preview does not execute operational commands."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅更改外观；明确选择作者布局才更改排列。取消不保存；预览不执行业务命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只改外觀；明確選取作者佈局才改排列。取消不保存；預覽不執行業務命令。"
          }
        }
      }
    },
    "只清理封面／表情与 metadata，服務拒絕與下載保護目錄交疊；不清理活動暫存、收藏、憑證或完成檔。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears only covers, emoticons, and metadata. The service rejects overlap with protected download directories; active temporary files, favorites, credentials, and completed files are not cleared."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只清理封面、表情和元数据；服务拒绝与受保护下载目录重叠，不清理活动临时文件、收藏、凭据或完成文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只清理封面／表情与 metadata，服務拒絕與下載保護目錄交疊；不清理活動暫存、收藏、憑證或完成檔。"
          }
        }
      }
    },
    "可從固定「功能」選單重新啟用；既有資料並未刪除。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-enable it from the fixed Features menu. Existing data has not been deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可从固定的“功能”菜单重新启用；现有数据未被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可從固定「功能」選單重新啟用；既有資料並未刪除。"
          }
        }
      }
    },
    "可清理：封面／表情與 metadata。保護：活動下載暫存、Torrent 私有資料、收藏、帳號與完成檔。用量來自既有 owned-cache 服務，不含任意目錄。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removable: covers, emoticons, and metadata. Protected: active download temporary files, private Torrent data, favorites, accounts, and completed files. Usage comes from the owned-cache service, not arbitrary directories."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可清理封面、表情和元数据。保护活动下载临时文件、Torrent 私有数据、收藏、账号和完成文件。只统计现有缓存服务管理的目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可清理：封面／表情與 metadata。保護：活動下載暫存、Torrent 私有資料、收藏、帳號與完成檔。用量來自既有 owned-cache 服務，不含任意目錄。"
          }
        }
      }
    },

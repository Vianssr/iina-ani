{
  "sourceLanguage": "en",
  "strings": {
    "Bangumi sign-in is not configured in this build. Configure Config/Local.xcconfig and rebuild.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bangumi sign-in is not configured in this build. Configure Config/Local.xcconfig and rebuild."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此构建尚未配置 Bangumi 登录。请配置 Config/Local.xcconfig 后重新构建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此建置尚未配置 Bangumi 登入。請配置 Config/Local.xcconfig 後重新建置。"
          }
        }
      }
    },
    "\n%lld 個目錄項目缺少有效同來源身份，未列入下載。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n%lld catalog entries lack valid same-source identities and were excluded from downloads."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n%lld 个目录项目缺少有效同来源身份，未列入下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n%lld 個目錄項目缺少有效同來源身份，未列入下載。"
          }
        }
      }
    },
    "\n封面暫時無法載入；其他作品資料仍可使用。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nCover is temporarily unavailable; other work data is still available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n封面暂时无法加载；其他作品数据仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n封面暫時無法載入；其他作品資料仍可使用。"
          }
        }
      }
    },
    "\n尚未確認；播放不需要 Bangumi，番劇關聯與映射在確認為番劇前不可用。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nNot confirmed. Playback does not require Bangumi; anime association and mapping remain unavailable until the type is confirmed as anime."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n尚未确认；播放不需要 Bangumi，确认为动画前无法进行番剧关联与映射。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n尚未確認；播放不需要 Bangumi，番劇關聯與映射在確認為番劇前不可用。"
          }
        }
      }
    },

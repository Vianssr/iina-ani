    "css1 番劇背景來源訂閱\n僅使用訪客能力；不匯入 Cookie、token、授權資料或腳本，不新增站點帳號。搜尋規則更新不代表播放或下載已驗證。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "css1 background anime source subscriptions\nGuest capabilities only; no Cookies, tokens, credentials, scripts, or site accounts are imported. Updated search rules do not mean playback or downloads have been verified."
          }
        },
        "zh-Hans": {
          "stringUnit": {

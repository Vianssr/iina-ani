{
  "version": 1,
  "sources": {
    "bilibili": {
      "hosts": ["api.bilibili.com"],
      "resultURLTemplate": "https://www.bilibili.com/video/{id}",
      "search": {
        "url": "https://api.bilibili.com/x/web-interface/search/type?search_type=video&page_size=20",
        "format": "json",
        "queryParameter": "keyword",
        "pageParameter": "page",
        "rowsPerPage": 20,
        "jsonResultsPath": "data.result",
        "jsonTitlePath": "title",
        "jsonIdentifierPath": "bvid",
        "jsonCoverPath": "pic",
        "jsonTotalPath": "data.numResults"
      }
    },
    "xifan": {
      "hosts": ["dm1.xfdm.pro"],
      "search": {
        "url": "https://dm1.xfdm.pro/search.html?wd={query}",
        "format": "html",
        "queryParameter": "wd",
        "pageParameter": "page",
        "rowsPerPage": 24,
        "nextPageSelector": "a[rel=next], a:contains(下一页), a:contains(下一頁), a[aria-label=Next]",
        "resultsSelector": ".public-list-box.search-box",
        "titleSelector": ".thumb-content > .thumb-txt",
        "linkSelector": ".public-list-exp",
        "coverSelector": ".public-list-exp img",
        "coverAttribute": "data-src",
        "hrefAttribute": "href"
      }
    },
    "girigiri": {
      "hosts": ["ani.girigirilove.com"],
      "search": {
        "url": "https://ani.girigirilove.com/search/-------------/?wd={query}",

        "queryParameter": "wd",
        "pageParameter": "page",
        "rowsPerPage": 24,
        "nextPageSelector": "a[rel=next], a:contains(下一页), a:contains(下一頁), a[aria-label=Next]",
        "resultsSelector": ".vod-detail",
        "titleSelector": ".detail-info .slide-info-title",
        "linkSelector": ".detail-info > a",
        "hrefAttribute": "href"
      }
    },
    "didahd": {

    "Only collection categories sync. Unclassified never deletes a remote collection. Watch progress, ratings and comments stay unchanged. Failed changes remain saved for retry, including after restart." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only collection categories sync. Unclassified never deletes a remote collection. Watch progress, ratings and comments stay unchanged. Failed changes remain saved for retry, including after restart."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅同步收藏分类。未分类不会删除远程收藏。观看进度、评分和评论均保持不变。失败的变更会保留，重启后仍可重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅同步收藏分類。未分類不會刪除遠端收藏。觀看進度、評分及評論均維持不變。失敗的變更會保留，重新啟動後仍可重試。"
          }
        }
      }
    },
    "Only compatible search rules are imported. Unsupported entries are skipped, and source enablement stays unchanged." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only compatible search rules are imported. Unsupported entries are skipped, and source enablement stays unchanged."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅导入兼容的搜索规则，跳过不支持的条目，来源启用状态保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅匯入相容的搜尋規則，略過不支援的項目，來源啟用狀態保持不變。"
          }
        }
      }
    },
    "Only explicit source episode bindings to public Bilibili XML are supported. No title matching or login bypass. The public comment pool may be incomplete." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only explicit source episode bindings to public Bilibili XML are supported. No title matching or login bypass. The public comment pool may be incomplete."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅支持来源剧集与公开 Bilibili XML 的明确绑定。不按标题匹配，也不绕过登录。公开弹幕池可能不完整。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅支援來源集數與公開 Bilibili XML 的明確綁定。不按標題配對，也不繞過登入。公開彈幕池可能不完整。"
          }
        }
      }
    },
    "Only one exact work, season and episode with independent year and format evidence can start automatically. Other matches require confirmation." : {

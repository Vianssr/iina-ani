    "CSS1 samples passed search, episode listing and media URL resolution. Playback is not guaranteed. Failed checks are skipped for this import; existing sources are kept.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CSS1 samples passed search, episode listing and media URL resolution. Playback is not guaranteed. Failed checks are skipped for this import; existing sources are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CSS1 样本已通过搜索、选集及媒体地址解析检查，不保证播放成功。未通过检查的来源本次跳过，已有来源保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CSS1 樣本已通過搜尋、選集及媒體位址解析檢查，不保證播放成功。未通過檢查的來源本次跳過，既有來源保留。"
          }
        }
      }
    },
